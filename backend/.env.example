# BrandPilot Backend Environment Configuration
PROJECT_NAME="BrandPilot — Trust Before Publish"
API_V1_STR="/api/v1"

# Security (Generate a strong 32+ character secret for production)
SECRET_KEY="brandpilot-change-this-in-production-secret-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
# DATABASE_URL="postgresql://brandpilot_user:password@localhost:5432/brandpilot_db"
DATABASE_URL="sqlite:///./brandpilot.db"

# Google Gemini API (Optional: if empty, deterministic RAG governance engine runs locally)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
