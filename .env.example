# BrandPilot Environment Variables Template
PROJECT_NAME="BrandPilot — Trust Before Publish"
API_V1_STR="/api/v1"

# Backend Security
SECRET_KEY="brandpilot-dev-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (SQLite default for development, PostgreSQL in production)
DATABASE_URL="sqlite:///./brandpilot.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/brandpilot_db"

# Google Gemini API Key (Optional: runs local deterministic RAG engine if omitted)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
